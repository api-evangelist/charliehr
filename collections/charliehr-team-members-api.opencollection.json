{
  "opencollection": "1.0.0",
  "info": {
    "name": "CharlieHR Company Team Members API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://charliehr.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Team Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List team members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://charliehr.com/api/v1/team_members",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated results."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of records to return per page."
              }
            ]
          },
          "docs": "Returns all of the authenticated company's team members. Supports pagination via the page and per_page query parameters."
        },
        {
          "info": {
            "name": "Get a team member",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://charliehr.com/api/v1/team_members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the team member."
              }
            ]
          },
          "docs": "Returns a single team member belonging to the authenticated company."
        },
        {
          "info": {
            "name": "List a team member's notes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://charliehr.com/api/v1/team_members/:id/notes",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the team member."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated results."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of records to return per page."
              }
            ]
          },
          "docs": "Returns the notes associated with a given team member."
        }
      ]
    }
  ],
  "bundled": true
}